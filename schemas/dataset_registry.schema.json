{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatasetRegistryRow",
  "description": "One datasets entry in configs/datasets.toml. Validated at runtime by DatasetSpec and load_dataset.",
  "type": "object",
  "required": [
    "name",
    "openml_id",
    "version",
    "md5_checksum",
    "source_url",
    "original_source_url",
    "license",
    "family",
    "clinical",
    "target",
    "positive_class",
    "class_labels",
    "expected_rows",
    "numeric_features",
    "categorical_features",
    "excluded_features",
    "split_strategy",
    "split_notes",
    "selection_reason"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "openml_id": {
      "type": "integer"
    },
    "version": {
      "type": "integer"
    },
    "md5_checksum": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "original_source_url": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "clinical": {
      "type": "boolean"
    },
    "target": {
      "type": "string"
    },
    "positive_class": {
      "type": "string"
    },
    "class_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_rows": {
      "type": "integer"
    },
    "numeric_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categorical_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "split_strategy": {
      "type": "string"
    },
    "split_notes": {
      "type": "string"
    },
    "selection_reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
