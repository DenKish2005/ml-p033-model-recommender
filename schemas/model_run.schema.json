  "properties": {
    "project": {
      "const": "CSCI447P033"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "protocol": {
      "oneOf": [
        {
          "$ref": "#/$defs/full_protocol"
        },
        {
          "$ref": "#/$defs/smoke_protocol"
        }
      ]
    },
    "research_valid": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "success",
        "excluded"
      ]
    },
    "status_note": {
      "type": "string"
    },
    "outer_splits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "aggregate": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "$ref": "#/$defs/full_success"
          },
          {
            "$ref": "#/$defs/smoke_success"
          }
        ]
      },
      "else": {
        "properties": {
          "research_valid": {
            "const": false
          },
          "aggregate": {
            "type": "null"
          }
        }
      }
    }
  ],
