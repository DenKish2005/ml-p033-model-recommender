{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P033 Dataset Benchmark Result",
  "type": "object",
  "required": ["project", "dataset", "protocol", "research_valid", "status", "outer_splits"],
  "properties": {
    "project": {"const": "CSCI447P033"},
    "research_valid": {"type": "boolean"},
    "status": {"enum": ["success", "excluded"]},
    "dataset": {
      "type": "object",
      "required": ["name", "openml_id", "version", "family", "clinical"]
    },
    "protocol": {
      "type": "object",
      "required": ["name", "outer_seeds", "inner_folds", "candidate_count"]
    },
    "outer_splits": {"type": "array"},
    "aggregate": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
