{"nodes": [{"id": "docs_experiment_plan_document", "label": "Research and Experiment Plan", "file_type": "document", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "Document", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_experiment_plan_rq1_unseen_selection", "label": "RQ1: Unseen Dataset Selection", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a71 \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u0438 \u0441\u0432\u044f\u0437\u044c \u0441 reference paper", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "RESEARCH_QUESTION", "description": "Predict two tuned pipelines performance advantage from dataset-level meta-features against fixed-choice baselines."}, {"id": "docs_experiment_plan_rq2_descriptor_associations", "label": "RQ2: Stable Descriptor Associations", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a71 \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u0438 \u0441\u0432\u044f\u0437\u044c \u0441 reference paper", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "RESEARCH_QUESTION", "description": "Study stable associations and ablations without causal feature-effect claims."}, {"id": "docs_experiment_plan_rq3_zero_shot_transfer", "label": "RQ3: General-to-Clinical Transfer", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a71 \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u0438 \u0441\u0432\u044f\u0437\u044c \u0441 reference paper", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "RESEARCH_QUESTION", "description": "Apply a frozen general-only recommender to independent clinical cohorts."}, {"id": "docs_experiment_plan_frozen_protocol_0_1", "label": "Frozen Binary Protocol 0.1", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a72 Frozen protocol0.1: \u0447\u0442\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "FROZEN_REPOSITORY_DECISION", "description": "HistGradientBoostingClassifier versus MLPClassifier; three 75/25 stratified holdouts, seeds 42/137/2026; inner three folds; 20 candidates per pipeline; BA primary. No real full results yet."}, {"id": "docs_experiment_plan_paired_nested_search", "label": "Paired Fold-Local Nested Search", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a72 Frozen protocol0.1: \u0447\u0442\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "IMPLEMENTED_WITH_VALIDATION_GAPS", "rationale": "Both pipelines share partitions; preprocessing is fit only within the current training fold; outer scores cannot select inner-HPO winners."}, {"id": "docs_experiment_plan_performance_gap", "label": "Dataset-Level MLP Minus GBDT Gap", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a76 Meta-dataset contract", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "REPOSITORY_CONTRACT", "description": "One row per canonical dataset; target mean BA(MLP)-mean BA(GBDT), averaged over outer splits; predicted gap >0.01 selects MLP, else GBDT."}, {"id": "docs_experiment_plan_matching_descriptor_sampling", "label": "Matching Development Descriptor Sampling", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a73 \u041f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0443\u0436\u043d\u043e freeze", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "PROPOSED_D015", "rationale": "Inference descriptors must match outer-training descriptors; three 75% stratified development subsets are proposed; labels are required for target-distribution descriptors."}, {"id": "docs_experiment_plan_compact_v2_schema", "label": "Compact Meta-Feature Schema v2", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a75 Meta-feature specification", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "PROPOSED_D016", "rationale": "Small dataset-level sample size makes many correlated predictors risky; preserve v1, evaluate compact v2 and register full-v2 ablations before outcomes."}, {"id": "docs_experiment_plan_clinical_zero_shot_protocol", "label": "Clinical Zero-Shot Protocol", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a78 Clinical zero-shot protocol", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "PLANNED_NOT_EMPIRICALLY_VERIFIED", "description": "Freeze general model/schema/margin/fallback; source-specific patient/time splits; save predictions before independent benchmark labels; no clinical refit/recalibration."}, {"id": "docs_experiment_plan_family_bootstrap", "label": "Family-Cluster Paired Regret Bootstrap", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a77 Recommender design \u0438 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u043d\u0438\u0435", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "PROPOSED_D018", "description": "B=2000, seed42, whole-family blocks from fixed OOF losses; conditional uncertainty, not independent outer-split observations or a prediction interval."}, {"id": "docs_experiment_plan_full_compute_budget", "label": "Full Protocol: 366 Fits per Dataset", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a710 Compute accounting \u0438 practical budget", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "PLANNED_ACCOUNTING_NOT_MEASURED", "description": "360 inner estimator fits +6 refits; smoke has 10 fits. Host cost must be measured before expanded scheduling; never silently reduce trials."}, {"id": "docs_experiment_plan_primary_meta_evaluation", "label": "Fixed Ridge and Family LOGO", "file_type": "concept", "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a73 \u041f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0443\u0436\u043d\u043e freeze; \u00a77 Recommender design \u0438 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u043d\u0438\u0435", "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "ACCEPTED_DESIGN_D013_D014", "rationale": "Fixed scaled Ridge alpha1 regularizes small meta samples; family LOGO and equal-dataset paired regret vs meta-train-selected best fixed are primary; prospective manifest remains outstanding."}], "edges": [{"source": "docs_experiment_plan_document", "target": "docs_experiment_plan_rq1_unseen_selection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a71 \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u0438 \u0441\u0432\u044f\u0437\u044c \u0441 reference paper", "weight": 1.0}, {"source": "docs_experiment_plan_document", "target": "docs_experiment_plan_rq2_descriptor_associations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EXPERIMENT_PLAN.md", "source_location": "\u00a71 \u041d\u0430\u0443\u0447\u043d\u0430\u044f \u0446\u0435\u043b\u044c \u0438 \u0441\u0432\u044f\u0437\u044c \u0441 reference paper", "weight": 1.0}, {"source": "docs_experiment_plan_